<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SpejsMealPlanner.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SpejsMealPlanner"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab x:Name="TabHome" Title="{DynamicResource TabHome}" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

        <Tab x:Name="TabObroci" Title="{DynamicResource TabMeals}" Icon="meals.png">
            <ShellContent ContentTemplate="{DataTemplate local:MealsManagerPage}" />
        </Tab>

        <Tab x:Name="TabSastojci" Title="{DynamicResource TabIngredients}" Icon="ingredients.png">
            <ShellContent ContentTemplate="{DataTemplate local:SastojciPage}" />
        </Tab>
    </TabBar>

</Shell>