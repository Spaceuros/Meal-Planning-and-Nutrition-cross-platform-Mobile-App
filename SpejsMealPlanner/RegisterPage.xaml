<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:RegisterViewModel"
             x:Class="SpejsMealPlanner.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        
        <Button Grid.Row="0"
                Text="{DynamicResource Back}"
                Command="{Binding GoBackCommand}"
                Style="{StaticResource ButtonSecondaryPill}"
                BorderWidth="0"
                HorizontalOptions="Start"
                Margin="15,15,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="{DynamicResource RegisterTitle}" Style="{StaticResource Headline}" />
                    <Label Text="{DynamicResource RegisterSubtitle}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                    <Button Grid.Column="0"
                            Text="{DynamicResource Consumer}"
                            BackgroundColor="{Binding ConsumerButtonColor}"
                            Command="{Binding SelectConsumerCommand}" />

                    <Button Grid.Column="1"
                            Text="{DynamicResource Chef}"
                            BackgroundColor="{Binding ChefButtonColor}"
                            Command="{Binding SelectChefCommand}" />
                </Grid>

                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{DynamicResource Name}" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding Name}"
                               Placeholder="{DynamicResource NamePlaceholder}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5" IsVisible="{Binding IsChef}">
                        <Label Text="{DynamicResource ChooseConsumer}" Style="{StaticResource Caption}" />
                        <Picker Title="{DynamicResource ChooseConsumerPlaceholder}"
                                ItemsSource="{Binding AvailableConsumers}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedConsumer}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="{DynamicResource PinRegisterLabel}" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding Pin}"
                               Placeholder="xxxx"
                               Keyboard="Numeric"
                               IsPassword="True"
                               MaxLength="4" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Button Text="{DynamicResource SaveUser}"
                        Margin="0,10,0,0"
                        Command="{Binding RegisterCommand}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>