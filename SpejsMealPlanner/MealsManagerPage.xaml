<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:MealsManagerViewModel"
             x:Class="SpejsMealPlanner.MealsManagerPage"
             Title="{DynamicResource MealsManagerTitle}">

    <Grid Padding="20">
        
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" Margin="0,0,0,15">
                <Label Grid.Column="0" Text="{DynamicResource YourMeals}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" VerticalOptions="Center" />
                
                <Button Grid.Column="1" Text="{DynamicResource History}" 
                        Command="{Binding OpenHistoryCommand}" 
                        Style="{StaticResource ButtonSecondaryPill}"
                        Padding="15,0" 
                        VerticalOptions="Center" />

                <Button Grid.Column="2" Text="{DynamicResource Logout}" 
                        Command="{Binding LogoutCommand}" 
                        Style="{StaticResource ButtonSecondaryPill}"
                        Padding="15,0" 
                        VerticalOptions="Center" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding ManagerMeals}">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="5">
                        <Label Text="{DynamicResource EmptyMealList}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{DynamicResource ClickToAddMeal}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems x:DataType="{x:Null}">
                                    <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MealsManagerViewModel}}, Path=EditMealCommand}" 
                                                   CommandParameter="{Binding .}">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="10,0,0,0" WidthRequest="80">
                                            <Label Text="{DynamicResource Edit}" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                    <SwipeItemView Command="{Binding BindingContext.DeleteMealCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                   CommandParameter="{Binding .}">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="10,0,0,0" WidthRequest="80">
                                            <Label Text="{DynamicResource Delete}" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" Padding="24">
                                <VerticalStackLayout Spacing="12">
                                    
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                                            <Label Text="{DynamicResource SwipeLeftOptions}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Calories}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                            <Label Text=" kcal" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,3" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="{StaticResource DividerSoft}" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MealIngredient">
                                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
                                                    <Label Grid.Column="0" Text="{Binding Item.Name}" VerticalOptions="Center" />
                                                    
                                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding Grams}" Style="{StaticResource Caption}" />
                                                        <Label Text="g" Style="{StaticResource Caption}" />
                                                    </HorizontalStackLayout>

                                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding CalculatedCalories}" FontAttributes="Bold" />
                                                        <Label Text="kcal" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,1" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    
                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border BackgroundColor="{StaticResource Primary}" WidthRequest="56" HeightRequest="56" 
                StrokeShape="RoundRectangle 28" StrokeThickness="0" 
                HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 0, 20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddNewMealCommand}" />
            </Border.GestureRecognizers>
            <Label Text="+" TextColor="{StaticResource OnPrimary}" FontSize="32" FontAttributes="Bold" 
                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0"/>
        </Border>

    </Grid>

</ContentPage>