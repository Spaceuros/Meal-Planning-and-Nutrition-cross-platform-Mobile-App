<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:MealsManagerViewModel"
             x:Class="SpejsMealPlanner.MealsManagerPage"
             Title="Upravljanje Obrocima"
             BackgroundColor="#0F172A">

    <Grid Padding="20">
        
        <Grid RowDefinitions="Auto, *">
            
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" Margin="0,0,0,15">
                <Label Grid.Column="0" Text="Tvoji Obroci" TextColor="White" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                
                <Button Grid.Column="1" Text="Istorija" 
                        Command="{Binding OpenHistoryCommand}" 
                        BackgroundColor="#334155" TextColor="White" 
                        CornerRadius="8" HeightRequest="36" Padding="15,0" 
                        VerticalOptions="Center" />

                <Button Grid.Column="2" Text="Odjavi se" 
                        Command="{Binding LogoutCommand}" 
                        BackgroundColor="#EF4444" TextColor="White" 
                        CornerRadius="8" HeightRequest="36" Padding="15,0" 
                        VerticalOptions="Center" />
            </Grid>

            <CollectionView Grid.Row="1" ItemsSource="{Binding ManagerMeals}">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="5">
                        <Label Text="Lista je prazna" TextColor="#64748B" FontSize="16" HorizontalOptions="Center" />
                        <Label Text="Klikni na + da dodaš novi obrok" TextColor="#475569" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems x:DataType="{x:Null}">
                                    <SwipeItem Text="Izmeni" BackgroundColor="#3B82F6" 
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MealsManagerViewModel}}, Path=EditMealCommand}" 
                                               CommandParameter="{Binding .}" />
                                    <SwipeItem Text="Obriši" BackgroundColor="#EF4444" 
                                                Command="{Binding BindingContext.DeleteMealCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#1E293B" StrokeThickness="0" Padding="15">
                                <VerticalStackLayout Spacing="12">
                                    
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                            <Label Text="Prevuci ulevo za opcije" FontSize="12" TextColor="#64748B" />
                                        </VerticalStackLayout>
                                        
                                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Calories}" FontSize="20" TextColor="#10B981" FontAttributes="Bold" />
                                            <Label Text=" kcal" FontSize="14" TextColor="#64748B" VerticalOptions="End" Margin="0,0,0,3" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#334155" />

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MealIngredient">
                                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15">
                                                    <Label Grid.Column="0" Text="{Binding Item.Name}" FontSize="14" TextColor="#CBD5E1" VerticalOptions="Center" />
                                                    
                                                    <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding Grams}" FontSize="14" TextColor="#94A3B8" />
                                                        <Label Text="g" FontSize="14" TextColor="#94A3B8" />
                                                    </HorizontalStackLayout>

                                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding CalculatedCalories}" FontSize="14" TextColor="#F87171" />
                                                        <Label Text="kcal" FontSize="12" TextColor="#64748B" VerticalOptions="End" Margin="0,0,0,1" />
                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    
                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Border BackgroundColor="#6366F1" WidthRequest="60" HeightRequest="60" 
                StrokeShape="RoundRectangle 30" StrokeThickness="0" 
                HorizontalOptions="End" VerticalOptions="End" Margin="0, 0, 0, 20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding AddNewMealCommand}" />
            </Border.GestureRecognizers>
            <Label Text="+" TextColor="White" FontSize="32" FontAttributes="Bold" 
                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0"/>
        </Border>

    </Grid>

</ContentPage>