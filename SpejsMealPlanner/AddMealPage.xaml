<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:AddMealViewModel"
             x:Class="SpejsMealPlanner.AddMealPage"
             Title="{DynamicResource AddMealTitle}">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <Label Text="{DynamicResource BasicInfo}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" />

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" StrokeShape="RoundRectangle 18" Padding="24">
                <VerticalStackLayout Spacing="15">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{DynamicResource MealName}" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding MealName}" Placeholder="{DynamicResource MealNamePlaceholder}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource DividerSoft}" />
                    
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{DynamicResource MealCategory}" Style="{StaticResource Caption}" />
                        <Entry Text="{Binding MealCategory}" Placeholder="{DynamicResource MealCategoryPlaceholder}" BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{DynamicResource IngredientsInMeal}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="2*, *, Auto" ColumnSpacing="10">
                <Picker ItemsSource="{Binding AvailableIngredients}" 
                        ItemDisplayBinding="{Binding Name}" 
                        SelectedItem="{Binding SelectedIngredient}"
                        Title="{DynamicResource Choose}" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" Grid.Column="0" />
                
                <Entry Text="{Binding GramsText}" Placeholder="{DynamicResource Grams}" Keyboard="Numeric" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" Grid.Column="1" />
                
                <Button Command="{Binding AddIngredientCommand}" Text="+" WidthRequest="50" Grid.Column="2" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentIngredients}" Spacing="10">
                <BindableLayout.EmptyView>
                    <Label Text="{DynamicResource NoIngredientsAdded}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,10,0,0"/>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:MealIngredient">
                        
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems x:DataType="{x:Null}">
                                    <SwipeItemView Command="{Binding BindingContext.RemoveIngredientCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                   CommandParameter="{Binding .}">
                                        <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="10,0,0,0" WidthRequest="80">
                                            <Label Text="{DynamicResource Delete}" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </SwipeItemView>
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" StrokeShape="RoundRectangle 18" Padding="15">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="15">
                                    <Label Text="{Binding Item.Name}" VerticalOptions="Center" Grid.Column="0" />
                                    <HorizontalStackLayout Spacing="5" Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Grams}" Style="{StaticResource Caption}" />
                                        <Label Text="g" Style="{StaticResource Caption}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                        
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Command="{Binding SaveMealCommand}" Text="{Binding SaveButtonText}" Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>