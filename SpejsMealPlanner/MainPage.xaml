<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:MainPageViewModel"
             x:Class="SpejsMealPlanner.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"> 

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="{DynamicResource PlanForToday}" Style="{StaticResource Caption}" TextTransform="Uppercase" FontAttributes="Bold" />
                    <Label Text="{Binding DateText}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="{DynamicResource Logout}"
                        Style="{StaticResource ButtonSecondaryPill}"
                        Padding="15,0"
                        VerticalOptions="Center"
                        Command="{Binding LogoutCommand}" />
            </Grid>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" StrokeShape="RoundRectangle 18" Padding="24">
                <VerticalStackLayout Spacing="20">
                    
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                        <Label Text="{Binding TotalCaloriesText}" TextColor="{StaticResource Primary}" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding GoalText}" Style="{StaticResource Caption}" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeGoalCommand}" />
                            </Label.GestureRecognizers>
                        </Label>                    
                    </VerticalStackLayout>

                    <ProgressBar Progress="{Binding CaloriesProgress}" HeightRequest="10" />

                    <BoxView HeightRequest="1" Color="{StaticResource DividerSoft}" Margin="0,5" />

                    <Grid ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{DynamicResource Protein}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding ProteinText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                <Label Text="g" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{DynamicResource Carbs}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding CarbsText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                <Label Text="g" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="{DynamicResource Fats}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding FatsText}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                <Label Text="g" Style="{StaticResource Caption}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto" Margin="0,10,0,0">
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="{DynamicResource WaterIntake}" 
                               FontAttributes="Bold" 
                               VerticalOptions="End" />
                        
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="End" Spacing="5" Margin="0,0,15,0">
                            <Label Text="{Binding WaterText}" FontAttributes="Bold" />
                            <Label Text="{Binding WaterGoalText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                     Progress="{Binding WaterProgress}" 
                                     HeightRequest="8" 
                                     Margin="0,8,15,0" />

                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                                Text="+" 
                                WidthRequest="44" 
                                HeightRequest="44" 
                                Padding="0" 
                                VerticalOptions="Center"
                                Command="{Binding AddWaterCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
            
            <VerticalStackLayout Spacing="15">
                <Label Text="{DynamicResource EnteredMeals}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" />
                
                <CollectionView ItemsSource="{Binding Meals}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" Margin="0,20,0,0" Spacing="5">
                            <Label Text="{DynamicResource NoMealsToday}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <Border StrokeShape="RoundRectangle 18" Stroke="{StaticResource Hairline}" StrokeThickness="1" Padding="24" Margin="0,0,0,10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasParchment}, Dark={StaticResource SurfaceTile3}}" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <VerticalStackLayout Spacing="10">
                                
                                <Grid ColumnDefinitions="Auto, *, Auto" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.ToggleExpandCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" Margin="0,0,15,0" StrokeShape="RoundRectangle 6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.ToggleEatenCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="{StaticResource Hairline}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        
                                        <Label Text="✓" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted48}, Dark={StaticResource BodyMuted}}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource OnDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    
                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Calories}" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkMuted48}, Dark={StaticResource BodyMuted}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text=" kcal" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,3" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="10" Margin="0,5,0,0">
                                    <BoxView HeightRequest="1" Color="{StaticResource DividerSoft}" />
                                    
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MealIngredient">
                                                <Grid ColumnDefinitions="*, Auto" Margin="40,0,0,0">
                                                    <Label Grid.Column="0" Text="{Binding Item.Name}" Style="{StaticResource Caption}" />
                                                    <Label Grid.Column="1" Text="{Binding Grams, StringFormat='{0}g'}" Style="{StaticResource Caption}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource CanvasParchment}, Dark={StaticResource SurfaceTile3}}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" Margin="40,5,0,0">
                                        <Grid ColumnDefinitions="*, *, *" HorizontalOptions="Fill">
                                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="{DynamicResource Protein}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding MealProtein, StringFormat='{0:F1}g'}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="{DynamicResource CarbsFull}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding MealCarbs, StringFormat='{0:F1}g'}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="{DynamicResource Fats}" Style="{StaticResource Caption}" />
                                                <Label Text="{Binding MealFats, StringFormat='{0:F1}g'}" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    
                                    <Button x:DataType="{x:Null}" 
                                            Text="{DynamicResource DeleteMeal}"
                                            Margin="40,10,0,0"
                                            Command="{Binding BindingContext.DeleteMealCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                                
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>