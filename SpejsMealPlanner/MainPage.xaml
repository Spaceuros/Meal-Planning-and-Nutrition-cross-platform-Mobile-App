<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:MainPageViewModel"
             x:Class="SpejsMealPlanner.MainPage"
             NavigationPage.HasNavigationBar="False"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0F172A"> 

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">
            
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Tvoj plan za danas" TextColor="#94A3B8" FontSize="14" TextTransform="Uppercase" FontAttributes="Bold" />
                    <Label Text="{Binding DateText}" TextColor="White" FontSize="28" FontAttributes="Bold" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="Odjavi se"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="35"
                        Padding="15,0"
                        VerticalOptions="Center"
                        Command="{Binding LogoutCommand}" />
            </Grid>

            <Border BackgroundColor="#1E293B" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="25">
                <VerticalStackLayout Spacing="20">
                    
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="0">
                        <Label Text="{Binding TotalCaloriesText}" TextColor="#10B981" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="{Binding GoalText}" FontSize="14" TextColor="#64748B" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeGoalCommand}" />
                            </Label.GestureRecognizers>
                        </Label>                    
                    </VerticalStackLayout>

                    <ProgressBar Progress="{Binding CaloriesProgress}" ProgressColor="#10B981" HeightRequest="10" />

                    <BoxView HeightRequest="1" Color="#334155" Margin="0,5" />

                    <Grid ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Proteini" TextColor="#94A3B8" FontSize="12" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding ProteinText}" TextColor="#3B82F6" FontSize="16" FontAttributes="Bold" />
                                <Label Text="g" TextColor="#94A3B8" FontSize="16" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Ugljeni H." TextColor="#94A3B8" FontSize="12" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding CarbsText}" TextColor="#F59E0B" FontSize="16" FontAttributes="Bold" />
                                <Label Text="g" TextColor="#94A3B8" FontSize="16" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Masti" TextColor="#94A3B8" FontSize="12" HorizontalOptions="Center" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding FatsText}" TextColor="#EF4444" FontSize="16" FontAttributes="Bold" />
                                <Label Text="g" TextColor="#94A3B8" FontSize="16" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto" Margin="0,10,0,0">
                        <Label Grid.Row="0" Grid.Column="0" 
                               Text="💧 Unos vode" 
                               TextColor="White" 
                               FontSize="14" 
                               FontAttributes="Bold" 
                               VerticalOptions="End" />
                        
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="End" Spacing="5" Margin="0,0,15,0">
                            <Label Text="{Binding WaterText}" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Label Text="{Binding WaterGoalText}" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                     Progress="{Binding WaterProgress}" 
                                     ProgressColor="#3B82F6" 
                                     HeightRequest="8" 
                                     Margin="0,8,15,0" />

                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                                Text="+" 
                                BackgroundColor="#3B82F6" 
                                TextColor="White" 
                                FontSize="24" 
                                WidthRequest="42" 
                                HeightRequest="42" 
                                CornerRadius="21" 
                                Padding="0" 
                                VerticalOptions="Center"
                                Command="{Binding AddWaterCommand}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>
            
            <VerticalStackLayout Spacing="15">
                <Label Text="Uneti obroci" TextColor="White" FontSize="18" FontAttributes="Bold" />
                
                <CollectionView ItemsSource="{Binding Meals}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" Margin="0,20,0,0" Spacing="5">
                            <Label Text="Još uvek nema obroka" TextColor="#64748B" FontSize="14" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="15" Margin="0,0,0,10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#0B1121" />
                                    <Setter Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#1E293B" />
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <VerticalStackLayout Spacing="10">
                                
                                <Grid ColumnDefinitions="Auto, *, Auto" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.ToggleExpandCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>

                                    <Border Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" Margin="0,0,15,0" StrokeShape="RoundRectangle 6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.ToggleEatenCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#10B981" />
                                                <Setter Property="Stroke" Value="#10B981" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsEaten}" Value="False">
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                                <Setter Property="Stroke" Value="#64748B" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        
                                        <Label Text="✓" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                    <Setter Property="IsVisible" Value="False" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="True">
                                                <Setter Property="TextColor" Value="#64748B" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                <Setter Property="TextColor" Value="White" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    
                                    <HorizontalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Calories}" FontSize="18" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="True">
                                                    <Setter Property="TextColor" Value="#64748B" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEaten}" Value="False">
                                                    <Setter Property="TextColor" Value="#10B981" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text=" kcal" FontSize="12" TextColor="#64748B" VerticalOptions="End" Margin="0,0,0,3" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="10" Margin="0,5,0,0">
                                    <BoxView HeightRequest="1" Color="#334155" />
                                    
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}" Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MealIngredient">
                                                <Grid ColumnDefinitions="*, Auto" Margin="40,0,0,0">
                                                    <Label Grid.Column="0" Text="{Binding Item.Name}" TextColor="#94A3B8" FontSize="14" />
                                                    <Label Grid.Column="1" Text="{Binding Grams, StringFormat='{0}g'}" TextColor="#64748B" FontSize="14" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    
                                    <Border BackgroundColor="#0F172A" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="10" Margin="40,5,0,0">
                                        <Grid ColumnDefinitions="*, *, *" HorizontalOptions="Fill">
                                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="Proteini" TextColor="#64748B" FontSize="12" />
                                                <Label Text="{Binding MealProtein, StringFormat='{0:F1}g'}" TextColor="#3B82F6" FontSize="14" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="Uglj. hidrati" TextColor="#64748B" FontSize="12" />
                                                <Label Text="{Binding MealCarbs, StringFormat='{0:F1}g'}" TextColor="#EAB308" FontSize="14" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                                                <Label Text="Masti" TextColor="#64748B" FontSize="12" />
                                                <Label Text="{Binding MealFats, StringFormat='{0:F1}g'}" TextColor="#F43F5E" FontSize="14" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    
                                    <Button x:DataType="{x:Null}" 
                                            Text="Obriši obrok"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            CornerRadius="8"
                                            HeightRequest="40"
                                            Margin="40,10,0,0"
                                            Command="{Binding BindingContext.DeleteMealCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                                
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>