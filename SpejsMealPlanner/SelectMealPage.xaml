<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:SelectMealViewModel"
             x:Class="SpejsMealPlanner.SelectMealPage"
             Title="Izaberi obrok"
             BackgroundColor="#0F172A">

    <Grid Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="Tvoj Meni" TextColor="White" FontSize="24" FontAttributes="Bold" />
            <Label Text="Dodaj gotov obrok u svoj današnji plan" TextColor="#94A3B8" FontSize="14" Margin="0,0,0,10" />

            <CollectionView ItemsSource="{Binding MenuMeals}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="5">
                        <Label Text="Nema gotovih obroka." TextColor="#64748B" FontSize="16" HorizontalOptions="Center" />
                        <Label Text="Kuvar ti još nije dodao nijedan obrok." TextColor="#475569" FontSize="14" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#1E293B" StrokeThickness="0" Padding="15">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.OdaberiObrokCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Calories}" FontSize="18" TextColor="#10B981" FontAttributes="Bold" />
                                    <Label Text=" kcal" FontSize="12" TextColor="#64748B" VerticalOptions="End" Margin="0,0,0,3" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>