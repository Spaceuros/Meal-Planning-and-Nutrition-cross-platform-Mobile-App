<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:SelectMealViewModel"
             x:Class="SpejsMealPlanner.SelectMealPage"
             Title="{DynamicResource SelectMealTitle}">

    <Grid Padding="20">
        <VerticalStackLayout Spacing="15">
            <Label Text="{DynamicResource YourMenu}" Style="{StaticResource SubHeadline}" HorizontalOptions="Start" FontAttributes="Bold" />
            <Label Text="{DynamicResource AddReadyMeal}" Style="{StaticResource Caption}" Margin="0,0,0,10" />

            <CollectionView ItemsSource="{Binding MenuMeals}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="5">
                        <Label Text="{DynamicResource NoReadyMeals}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{DynamicResource ChefNotAddedMeals}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Meal">
                        <Border StrokeShape="RoundRectangle 18" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" Padding="24">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer x:DataType="{x:Null}" Command="{Binding BindingContext.OdaberiObrokCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Calories}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                    <Label Text=" kcal" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,3" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>