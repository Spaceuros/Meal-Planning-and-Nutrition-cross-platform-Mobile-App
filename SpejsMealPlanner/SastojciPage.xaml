<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SpejsMealPlanner.Models"
             xmlns:viewmodels="clr-namespace:SpejsMealPlanner.ViewModels"
             x:DataType="viewmodels:SastojciViewModel"
             x:Class="SpejsMealPlanner.SastojciPage"
             Title="{DynamicResource IngredientsDatabase}">

    <Grid RowDefinitions="Auto, *" Padding="20">
        
        <Border Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" StrokeShape="RoundRectangle 18" Padding="24" Margin="0,0,0,20">
            <VerticalStackLayout Spacing="15">
                <Label Text="{DynamicResource AddNewIngredient}" FontAttributes="Bold" />
                
                <Entry Text="{Binding NameEntryText}" Placeholder="{DynamicResource IngredientNamePlaceholder}" />
                
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Kcal" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Entry Text="{Binding CaloriesEntryText}" Keyboard="Numeric" Placeholder="0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{DynamicResource Protein}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Entry Text="{Binding ProteinEntryText}" Keyboard="Numeric" Placeholder="0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="{DynamicResource Carbs}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Entry Text="{Binding CarbsEntryText}" Keyboard="Numeric" Placeholder="0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="3" Spacing="2">
                        <Label Text="{DynamicResource Fats}" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Entry Text="{Binding FatsEntryText}" Keyboard="Numeric" Placeholder="0" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Button Command="{Binding AddIngredientCommand}" Text="{DynamicResource AddToDatabase}" />
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Ingredients}">
            
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="{DynamicResource IngredientsDatabaseEmpty}" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,20,0,0"/>
            </CollectionView.EmptyView>
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Ingredient">
                    
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems x:DataType="{x:Null}">
                                <SwipeItemView Command="{Binding BindingContext.EditIngredientCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                               CommandParameter="{Binding .}">
                                    <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="10,0,0,0" WidthRequest="80">
                                        <Label Text="{DynamicResource Edit}" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                                
                                <SwipeItemView Command="{Binding BindingContext.DeleteIngredientCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                               CommandParameter="{Binding .}">
                                    <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" StrokeThickness="0" Margin="10,0,0,0" WidthRequest="80">
                                        <Label Text="{DynamicResource Delete}" TextColor="{StaticResource OnPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </SwipeItemView>
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Canvas}, Dark={StaticResource SurfaceTile1}}" StrokeThickness="1" Stroke="{StaticResource Hairline}" StrokeShape="RoundRectangle 18" Padding="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="2">
                                        <Label Text="{Binding Calories}" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                                        <Label Text=" kcal / 100g" Style="{StaticResource Caption}" VerticalOptions="End" Margin="0,0,0,1"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="10">
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="P" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Protein}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="UH" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Carbs}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout HorizontalOptions="Center">
                                        <Label Text="M" Style="{StaticResource Caption}" HorizontalOptions="Center" />
                                        <Label Text="{Binding Fats}" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </SwipeView>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </Grid>
</ContentPage>